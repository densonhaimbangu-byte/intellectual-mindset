# --- Supabase (your OWN project: supabase.com > Project Settings > API) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only, never expose
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Site ---
VITE_SITE_URL=https://yourdomain.com

# --- AI chat assistant (optional; can also be saved in admin_secrets as ai_api_key) ---
OPENAI_API_KEY=

# --- Cron endpoints (optional) ---
CRON_SECRET=

# Bank card (HandyPay)
HANDYPAY_API_KEY=
HANDYPAY_API_URL=
HANDYPAY_WEBHOOK_SECRET=
# Crypto (NOWPayments)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Prices are in NAD; used to convert to USD for crypto invoices
NAD_PER_USD=18.5
